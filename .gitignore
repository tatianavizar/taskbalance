# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep

#Ignore this
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Secrets, keys and credentials — never commit these.
# Note: config/credentials.yml.enc IS tracked on purpose; it is encrypted and
# useless without config/master.key, which is ignored above.
# .kamal/secrets is also tracked on purpose: it is the stock Kamal template
# and holds only shell references, never raw values.
# ---------------------------------------------------------------------------

# Rails credential keys (per-environment credentials)
/config/credentials/*.key

# Private keys, certificates, keystores
*.pem
*.key
*.p12
*.pfx
*.ppk
*.jks
*.keystore
id_rsa
id_ecdsa
id_ed25519
*_rsa
*_ed25519

# Credential files that must never be copied into the repo
.ssh/
.netrc
.npmrc

# Environment files in any directory (the /.env* rule above only covers root)
.env
.env.*
!.env.example

# Local databases
*.sqlite3
*.sqlite3-journal

# macOS
.DS_Store

# Agent worktrees
/.worktrees/
