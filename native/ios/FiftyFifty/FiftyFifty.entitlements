<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (APNs). Xcode switches it to "production" when exporting for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: the server answers /.well-known/apple-app-site-association (NativeApp). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:cinquante.app</string>
		<string>webcredentials:cinquante.app</string>
	</array>
</dict>
</plist>
