<?xml version="1.0" encoding="utf-8"?>
<!-- One NavigatorHost per tab; MainActivity shows the selected one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navigator_home"
            android:name="dev.hotwire.navigation.navigator.NavigatorHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="false" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navigator_tasks"
            android:name="dev.hotwire.navigation.navigator.NavigatorHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:defaultNavHost="false" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navigator_report"
            android:name="dev.hotwire.navigation.navigator.NavigatorHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:defaultNavHost="false" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navigator_household"
            android:name="dev.hotwire.navigation.navigator.NavigatorHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:defaultNavHost="false" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:itemIconTint="@color/tab_tint"
        app:itemTextColor="@color/tab_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/tabs" />
</LinearLayout>
