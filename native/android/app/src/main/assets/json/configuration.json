{
  "settings": {},
  "rules": [
    {
      "patterns": [".*"],
      "properties": { "context": "default", "uri": "hotwire://fragment/web", "pull_to_refresh_enabled": true }
    },
    {
      "patterns": ["/new$", "/edit$", "/completion/new$", "/delete$", "/cancel$"],
      "properties": { "context": "modal", "uri": "hotwire://fragment/web/modal/sheet", "pull_to_refresh_enabled": false }
    },
    {
      "patterns": ["/recede_historical_location$", "/resume_historical_location$", "/refresh_historical_location$"],
      "properties": { "presentation": "none" }
    }
  ]
}
