<div class="space-y-3 p-4 text-sm">
  <p>
    Supprime le compte de <strong><%= user.first_name %></strong> comme si la personne le faisait elle-même :
    elle quitte son foyer (ses tâches passent aux autres membres), <strong>tous ses enregistrements sont supprimés</strong>,
    ses préférences et notifications aussi. Les bilans passés du foyer gardent leurs chiffres, sous « Ancien membre ».
    Il n'y a pas de retour en arrière.
  </p>
  <%= form_with url: delete_account_admin_user_path(user), method: :post, builder: ActionView::Helpers::FormBuilder,
                class: "space-y-2", data: { turbo: false } do |form| %>
    <%= form.label :typed_email, "Saisir l'email du compte pour confirmer : #{user.email}", class: "block font-semibold" %>
    <%= form.text_field :typed_email, autocomplete: "off", required: true,
                        class: "block w-full max-w-md rounded-lg border border-gray-300 px-3 py-2" %>
    <%= form.submit "Supprimer le compte", class: "cursor-pointer rounded-lg bg-blue-600 px-4 py-2 font-bold text-white",
                    data: { confirm: "Supprimer définitivement le compte de #{user.first_name} et tous ses enregistrements ?" } %>
  <% end %>
</div>
