<div class="admin-auth-card space-y-5">
  <h2 class="text-xl font-bold"><%= site_title %></h2>
  <% set_page_title t("back_office.two_factor.title") %>

  <div>
    <h3 class="text-lg font-bold"><%= t("back_office.two_factor.title") %></h3>
    <p class="mt-1 text-sm text-gray-500"><%= t("back_office.two_factor.intro") %></p>
  </div>

  <ol class="space-y-4 text-sm">
    <li>
      <p class="font-semibold"><%= t("back_office.two_factor.step_app") %></p>
    </li>
    <li>
      <p class="font-semibold"><%= t("back_office.two_factor.step_secret") %></p>
      <p class="mt-2 rounded-lg bg-gray-100 px-3 py-2 font-mono text-base tracking-wider break-all" data-test-otp-secret><%= @secret.scan(/.{1,4}/).join(" ") %></p>
      <p class="mt-2 text-gray-500">
        <%= t("back_office.two_factor.account_label") %> <span class="font-mono"><%= current_admin_user.email %></span>
        · <%= link_to t("back_office.two_factor.open_in_app"), @provisioning_uri, class: "underline" %>
      </p>
    </li>
    <li>
      <p class="font-semibold"><%= t("back_office.two_factor.step_code") %></p>
      <%= form_with url: back_office_two_factor_path, method: :post, builder: ActionView::Helpers::FormBuilder, class: "mt-2 space-y-3" do |form| %>
        <%= form.label :code, t("back_office.two_factor.code_label"), class: "block text-sm font-semibold" %>
        <%= form.text_field :code, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", pattern: "[0-9 ]*", maxlength: 7,
                            class: "block w-full rounded-lg border border-gray-300 px-3 py-2 tracking-widest" %>
        <%= form.submit t("back_office.two_factor.submit"), class: "w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-2 font-bold text-white" %>
      <% end %>
    </li>
  </ol>

  <p class="text-sm"><%= link_to t("active_admin.logout"), destroy_admin_user_session_path, data: { turbo_method: :delete, method: :delete }, class: "underline" %></p>
</div>
