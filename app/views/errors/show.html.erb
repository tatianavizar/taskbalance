<% provide :chrome, "none" %>
<% provide :title, t("errors.#{@key}.title") %>
<% home = user_signed_in? ? dashboard_path : root_path %>
<div class="flex flex-col gap-5 flex-1 pt-20">
  <% if @code == 403 %>
    <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="#0f1a14" stroke-width="1.6" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
  <% elsif @code == 500 %>
    <svg width="72" height="72" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="13" fill="#c3d9cc" stroke="#0f1a14" stroke-width="3"></circle><path d="M25 8 A13 13 0 1 0 25 32 Z" fill="#c3d9cc"></path><path d="M20 2 V38" stroke="#0f1a14" stroke-width="3" fill="none"></path></svg>
  <% else %>
    <svg width="72" height="72" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="17" fill="none" stroke="#0f1a14" stroke-width="3" stroke-dasharray="4 4"></circle></svg>
  <% end %>

  <h1 class="screen-title"><%= t("errors.#{@key}.title") %></h1>
  <p class="m-0"><%= t("errors.#{@key}.body") %></p>
  <p class="m-0 text-[13px] text-muted"><%= t("errors.code", code: @code) %><%= " · #{l(Time.current, format: :hour)}" if @code == 500 %></p>

  <%= sticky_cta do %>
    <%= link_to t(@code == 403 ? "errors.forbidden.cta" : "errors.back_home"), home, class: "btn btn-primary" %>
  <% end %>
</div>
