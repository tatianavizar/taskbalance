<% provide :chrome, "none" %>
<div class="flex flex-col gap-7 flex-1 pt-12">
  <%= logo(size: 88) %>
  <div>
    <h1 class="m-0 text-[40px] leading-[44px] font-bold"><%= t("app.name") %></h1>
    <p class="mt-3 mb-0 text-lg leading-[26px]"><%= t("intro.welcome.body") %></p>
  </div>

  <%= callout do %>
    <div class="flex flex-col gap-2.5">
      <div class="flex justify-between gap-3"><b><%= t("intro.welcome.mental") %></b><span><%= t("intro.welcome.mental_hint") %></span></div>
      <div class="flex justify-between gap-3"><b><%= t("intro.welcome.execution") %></b><span><%= t("intro.welcome.execution_hint") %></span></div>
      <div class="flex justify-between gap-3"><b><%= t("intro.welcome.time") %></b><span><%= t("intro.welcome.time_hint") %></span></div>
      <div class="text-[13px] leading-[18px] mt-1"><%= t("intro.welcome.note") %></div>
    </div>
  <% end %>

  <div class="mt-auto flex flex-col gap-3 pb-2">
    <% if @intro_seen %>
      <%= link_to t("intro.welcome.sign_up"), new_user_registration_path, class: "btn btn-primary" %>
    <% else %>
      <%= link_to t("intro.welcome.discover"), intro_path(1), class: "btn btn-primary" %>
    <% end %>
    <%= link_to t("intro.welcome.have_account"), new_user_session_path, class: "btn btn-secondary" %>
    <p class="mt-1 mb-0 text-center text-[13px] text-muted"><%= t("intro.welcome.invitation") %></p>
  </div>
</div>
