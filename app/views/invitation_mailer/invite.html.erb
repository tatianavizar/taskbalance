<% if @invitation.first_name.present? %><p><%= t("invitation_mailer.invite.greeting", name: @invitation.first_name) %></p><% end %>
<h1><%= t("invitation_mailer.invite.heading", inviter: @inviter_name) %></h1>

<p><%= t("invitation_mailer.invite.what") %></p>

<p><%= t("invitation_mailer.invite.visibility_html", household: tag.strong(@household.name), inviter: @inviter_name) %></p>

<p><%= link_to t("invitation_mailer.invite.cta"), @invitation_url %></p>

<p><%= t("invitation_mailer.invite.footer", date: @expires_on, email: @invitation.email) %></p>
