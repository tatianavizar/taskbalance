<% provide :title, t("auth.account.title") %>
<h1 class="screen-title"><%= t("auth.account.title") %></h1>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "flex flex-col gap-4" }) do |f| %>
  <%= f.error_summary %>
  <%= f.field :first_name, autocomplete: "given-name" %>
  <%= f.field :email, as: :email, autocomplete: "email" %>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <p class="text-sm text-muted m-0"><%= t("devise.registrations.edit.currently_waiting_confirmation_for_email", email: resource.unconfirmed_email) %></p>
  <% end %>

  <%= f.field :password, as: :password, required: false, autocomplete: "new-password",
        hint: t("devise.registrations.edit.leave_blank_if_you_don_t_want_to_change_it").capitalize %>
  <%= f.field :password_confirmation, as: :password, autocomplete: "new-password" %>
  <%= f.field :current_password, as: :password, autocomplete: "current-password",
        hint: t("devise.registrations.edit.we_need_your_current_password_to_confirm_your_changes").capitalize %>

  <%= f.submit t("devise.registrations.edit.update") %>
<% end %>

<%= card do %>
  <h2 class="font-sans text-base font-bold m-0"><%= t("devise.registrations.edit.cancel_my_account") %></h2>
  <p class="text-sm text-muted my-2"><%= t("auth.account.cancel_hint") %></p>
  <%= button_to t("devise.registrations.edit.cancel_my_account"), registration_path(resource_name),
        method: :delete, class: "btn btn-outline",
        form: { data: { turbo_confirm: t("auth.account.cancel_confirm") } } %>
<% end %>

<%= link_to t("common.back"), :back, class: "link text-center" %>
