<% provide :chrome, "none" %>
<% provide :title, t("auth.sign_in") %>
<%= back_button root_path %>
<h1 class="screen-title"><%= t("auth.sign_in") %></h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-4 flex-1" }) do |f| %>
  <%= f.field :email, as: :email, autofocus: true, autocomplete: "email" %>
  <%= f.field :password, as: :password, autocomplete: "current-password" %>
  <div class="flex justify-between items-center min-h-[44px]">
    <%= f.checkbox_field :remember_me if devise_mapping.rememberable? %>
    <%= link_to t("devise.passwords.new.forgot_your_password"), new_password_path(resource_name), class: "font-semibold text-sm" %>
  </div>

  <%= sticky_cta do %>
    <%= f.submit t("auth.sign_in") %>
    <p class="text-center text-sm m-0"><%= t("auth.no_account") %> <%= link_to t("auth.sign_up.title"), new_registration_path(resource_name), class: "font-semibold" %></p>
  <% end %>
<% end %>
