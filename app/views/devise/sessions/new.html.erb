<% provide :chrome, "none" %>
<% provide :title, t("auth.sign_in") %>
<%= back_button root_path %>
<h1 class="screen-title"><%= t("auth.sign_in") %></h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-4 flex-1" }) do |f| %>
  <% if @auth_failed %>
    <div class="alert-box" role="alert">
      <b><%= t("auth.sign_in_form.failed_title") %></b><br><%= t("auth.sign_in_form.failed_body") %>
    </div>
  <% end %>
  <%= f.field :email, as: :email, autofocus: true, autocomplete: "email", "aria-invalid": (@auth_failed ? "true" : nil) %>
  <%= f.field :password, as: :password, autocomplete: "current-password", "aria-invalid": (@auth_failed ? "true" : nil) %>

  <% if @auth_failed %>
    <%= link_to t("auth.sign_in_form.failed_link"), new_password_path(resource_name), class: "font-semibold text-sm flex items-center min-h-[44px]" %>
    <p class="m-0 text-[13px] leading-[18px] text-muted"><%= t("auth.sign_in_form.failed_note") %></p>
  <% else %>
    <div class="flex justify-end items-center min-h-[44px]">
      <%= link_to t("devise.passwords.new.forgot_your_password"), new_password_path(resource_name), class: "font-semibold text-sm inline-flex items-center min-h-[44px]" %>
    </div>
  <% end %>

  <%= sticky_cta do %>
    <%= f.submit t("auth.sign_in") %>
    <p class="text-center text-sm m-0"><%= t("auth.no_account") %> <%= link_to t("auth.sign_up.title"), new_registration_path(resource_name), class: "font-semibold" %></p>
  <% end %>
<% end %>
