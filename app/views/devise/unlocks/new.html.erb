<% provide :chrome, "none" %>
<% provide :title, t("devise.unlocks.new.resend_unlock_instructions") %>
<%= back_button new_session_path(resource_name) %>
<h1 class="screen-title"><%= t("devise.unlocks.new.resend_unlock_instructions") %></h1>

<%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "flex flex-col gap-4 flex-1" }) do |f| %>
  <%= f.error_summary %>
  <%= f.field :email, as: :email, autofocus: true, autocomplete: "email" %>
  <%= sticky_cta do %>
    <%= f.submit t("devise.unlocks.new.resend_unlock_instructions") %>
  <% end %>
<% end %>
