<% provide :chrome, "none" %>
<% provide :title, t("devise.confirmations.new.resend_confirmation_instructions") %>
<%= back_button new_session_path(resource_name) %>
<h1 class="screen-title"><%= t("devise.confirmations.new.resend_confirmation_instructions") %></h1>

<%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "flex flex-col gap-4 flex-1" }) do |f| %>
  <%= f.error_summary %>
  <%= f.field :email, as: :email, autofocus: true, autocomplete: "email",
        value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) %>
  <%= sticky_cta do %>
    <%= f.submit t("devise.confirmations.new.resend_confirmation_instructions") %>
  <% end %>
<% end %>
