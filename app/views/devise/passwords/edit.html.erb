<% provide :chrome, "none" %>
<% provide :title, t("devise.passwords.edit.change_your_password") %>
<h1 class="screen-title"><%= t("devise.passwords.edit.change_your_password") %></h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "flex flex-col gap-4 flex-1" }) do |f| %>
  <%= f.error_summary %>
  <%= f.hidden_field :reset_password_token, value: resource.reset_password_token %>
  <%= f.field :password, as: :password, label: t("devise.passwords.edit.new_password"), autofocus: true, autocomplete: "new-password",
        hint: (t("auth.password_hint", count: @minimum_password_length) if @minimum_password_length) %>
  <%= f.field :password_confirmation, as: :password, label: t("devise.passwords.edit.confirm_new_password"), autocomplete: "new-password" %>
  <%= sticky_cta do %>
    <%= f.submit t("devise.passwords.edit.change_my_password") %>
  <% end %>
<% end %>
