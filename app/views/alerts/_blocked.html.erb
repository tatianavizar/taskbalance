<%# E4 : le foyer est bloqué. E15 : la même alerte vue par la personne concernée. %>
<% names = concerned.map { |member| member.user.first_name }.to_sentence %>
<section class="flex flex-col gap-3" aria-labelledby="alert-blocked-title" id="alert-blocked">
  <div class="alert-panel">
    <div class="flex items-center gap-2">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-mint)" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
      <h2 id="alert-blocked-title" class="m-0 text-lg leading-6 font-bold">
        <% if viewer_concerned %>
          <%= t("alerts.blocked.title_self", level: level, weeks: weeks) %>
        <% else %>
          <%= t("alerts.blocked.title_others", count: concerned.size, level: level, names: names, weeks: weeks) %>
        <% end %>
      </h2>
    </div>
    <p class="mt-2 mb-0 text-sm leading-5">
      <%= t("alerts.blocked.dates", from: l(from, format: :short), to: l(to, format: :short)) %>
      <%= viewer_concerned ? t("alerts.blocked.question_self") : t("alerts.blocked.question_others", names: names) %>
    </p>
    <% if viewer_concerned %>
      <%= link_to t("alerts.pause_link"), new_member_pause_path(du: from, au: to) %>
    <% else %>
      <% open_inquiries.each do |inquiry| %>
        <% member = inquiry.household_member %>
        <div><%= link_to t("alerts.pause_for_link", name: member.user.first_name),
                  new_member_pause_path(pour: member.id, du: inquiry.first_week_start, au: inquiry.last_week_start + 6) %></div>
      <% end %>
    <% end %>
  </div>

  <div class="card">
    <b><%= t("alerts.blocked.unblock_title") %></b>
    <p class="mt-1 mb-0 text-sm leading-5"><%= t("alerts.blocked.unblock_body") %></p>
    <ul class="mt-2 mb-0 p-0 list-none tabular">
      <% progress.each do |row| %>
        <li class="flex justify-between min-h-[30px] items-center text-sm">
          <span><%= t("alerts.blocked.since_monday", name: row[:name]) %></span>
          <b><%= t("alerts.blocked.tasks", count: row[:count]) %></b>
        </li>
      <% end %>
    </ul>
  </div>

  <%= level_progress level: level, done: current_household.balanced_weeks_count,
        total: (level >= Progression::ULTIMATE ? nil : Progression.threshold(level + 1)), href: levels_path %>
</section>
