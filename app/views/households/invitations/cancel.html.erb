<%# B15: confirmation before cancelling. Both answers weigh the same. %>
<% provide :chrome, "none" %>
<% provide :title, t("invitations.cancel.title") %>
<div class="flex-1"></div>
<div role="alertdialog" aria-labelledby="cancel-title" aria-describedby="cancel-body" class="flex flex-col gap-3.5">
  <h1 id="cancel-title" class="screen-title"><%= t("invitations.cancel.title") %></h1>
  <p id="cancel-body" class="m-0 text-sm leading-5"><%= t("invitations.cancel.body", email: @invitation.email) %></p>
  <%= button_to t("invitations.cancel.confirm"), household_invitation_path(@household, @invitation),
        method: :delete, class: "btn btn-primary w-full", form_class: "contents" %>
  <%= link_to t("invitations.cancel.keep"), household_invitation_path(@household, @invitation), class: "btn btn-secondary" %>
</div>
