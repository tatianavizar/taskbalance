<% provide :chrome, "none" %>
<% provide :title, t("chores.setup.title") %>
<%= back_button household_path(@household) %>
<div>
  <h1 class="screen-title"><%= t("chores.setup.title") %></h1>
  <p class="screen-subtitle"><%= @household.name %> · <%= t("chores.setup.note") %></p>
</div>

<%= form_with url: household_chores_setup_path(@household), method: :patch, html: { class: "flex flex-col gap-5 flex-1" } do %>
  <% @tasks_by_category.each do |category, tasks| %>
    <fieldset class="min-w-0">
      <legend class="text-base font-bold mb-1"><%= t("tasks.categories.#{category}") %></legend>
      <% tasks.each do |task| %>
        <label for="task_<%= task.id %>" class="flex items-center gap-3 min-h-[44px] py-2 cursor-pointer">
          <%= check_box_tag "task_ids[]", task.id, @existing_task_ids.include?(task.id), class: "check-input", id: "task_#{task.id}" %>
          <span class="check-box"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg></span>
          <span class="flex-1"><%= task.name %></span>
          <span class="text-[13px] text-muted"><%= t("tasks.index.time_required", count: task.time_required) %></span>
        </label>
      <% end %>
    </fieldset>
  <% end %>

  <%= sticky_cta do %>
    <%= submit_tag t("chores.setup.submit"), class: "btn btn-primary" %>
  <% end %>
<% end %>
