<%# Mise en place, étape 2 : inviter la personne avec qui on partage le foyer. %>
<% provide :chrome, "none" %>
<% provide :title, t("setup.title") %>
<div class="flex items-center gap-2.5">
  <%= back_button(dashboard_path) %>
  <%= logo %>
  <span class="font-bold"><%= t("setup.title") %></span>
</div>

<%= step_progress steps: t("households.new.steps"), current: 2 %>

<div>
  <h1 class="screen-title"><%= t("setup.partner.heading") %></h1>
  <p class="screen-subtitle"><%= t("setup.partner.subtitle") %></p>
</div>

<%# P1 : à partir de la deuxième invitation, l'écran liste tout le foyer et propose d'inviter une autre personne. %>
<% size = @household.expected_size %>
<% if @invitations.any? %>
  <section class="flex flex-col gap-2" aria-labelledby="members-title">
    <h2 id="members-title" class="m-0 text-[15px] font-bold font-sans"><%= t("setup.partner.members_title") %></h2>
    <% if size >= 3 %>
      <p class="screen-subtitle m-0"><%= t("setup.partner.size_hint", size: size, fair: HouseholdRules.fair_share(size), min: HouseholdRules.zone(size).min, max: HouseholdRules.zone(size).max) %></p>
    <% end %>
    <div class="list-stack">
      <% @household.household_members.includes(:user).order(:created_at, :id).each do |member| %>
        <%= list_row title: member.user.first_name, subtitle: (member.user_id == current_user.id ? t("setup.partner.you_creator") : nil),
              leading: avatar(initials: member.monogram, color: member.color, size: 36) %>
      <% end %>
      <% @invitations.each do |invitation| %>
        <%= list_row title: invitation.display_name, subtitle: "#{invitation.email} · #{t("setup.partner.invited")}",
              href: household_invitation_path(@household, invitation),
              leading: avatar(initials: invitation.display_name.first.upcase, pending: true, size: 36) %>
      <% end %>
    </div>
    <% if @household.room_for_another_person? %>
      <%= link_to t("setup.partner.invite_another"), new_household_invitation_path(@household, setup: 1), class: "btn btn-secondary" %>
    <% else %>
      <p class="m-0 text-[13px] leading-[18px] text-muted"><%= t("setup.partner.full", max: HouseholdMember::COLORS.size) %></p>
    <% end %>
  </section>
<% end %>

<%= sticky_cta do %>
  <% if @invitations.any? %>
    <%= button_to t("setup.partner.continue"), household_setup_path(@household), method: :patch, class: "btn btn-primary" %>
  <% else %>
    <%= link_to t("setup.partner.invite"), new_household_invitation_path(@household, setup: 1), class: "btn btn-primary" %>
    <%= button_to t("setup.partner.skip"), household_setup_path(@household), method: :patch, class: "btn btn-secondary" %>
  <% end %>
<% end %>
