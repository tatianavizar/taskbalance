<% provide :title, t("households.index.title") %>
<h1 class="screen-title"><%= t("households.index.title") %></h1>

<% if @households.empty? %>
  <%= callout do %>
    <p class="m-0"><%= t("households.index.empty") %></p>
  <% end %>
<% else %>
  <div class="list-stack">
    <% @households.each do |household| %>
      <%= list_row title: household.name, subtitle: t("common.members_count", count: household.users.count),
            href: household_path(household) %>
    <% end %>
  </div>
<% end %>

<%= sticky_cta do %>
  <%= link_to t("households.index.new_link"), new_household_path, class: "btn btn-primary" %>
<% end %>
