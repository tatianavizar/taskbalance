<%# F3 : suppression du foyer, réservée à la personne qui le gère, après saisie de son nom. %>
<% provide :chrome, "none" %>
<% provide :title, t("households.delete.title", name: @household.name) %>
<% members = @household.household_members.includes(:user).order(:created_at, :id).to_a %>
<% others = members.reject { |member| member.user_id == current_user.id }.map { |member| member.user.first_name } %>
<%= back_button household_path(@household) %>
<h1 class="screen-title"><%= t("households.delete.title", name: @household.name) %></h1>

<div class="alert-box">
  <b><%= t("households.delete.definitive", names: members.map { |member| t("households.delete.for", name: member.user.first_name) }.to_sentence) %></b>
  <%= t("households.delete.what", count: @household.chores.count) %>
</div>

<%= form_with model: @deletion, scope: :household_deletion, url: household_path(@household), method: :delete,
      html: { class: "flex flex-col gap-4 flex-1" } do |f| %>
  <%= f.field :confirmation_name, label: t("households.delete.label"), autocomplete: "off", autocapitalize: "off", spellcheck: false,
        hint: [ t("households.delete.manager_hint"), (t("households.delete.email_hint", count: others.size, names: others.to_sentence) if others.any?) ].compact.join(" ") %>
  <%= sticky_cta do %>
    <%= f.submit t("households.delete.confirm"), variant: :outline %>
    <%= link_to t("common.cancel"), household_path(@household), class: "btn btn-secondary" %>
  <% end %>
<% end %>
