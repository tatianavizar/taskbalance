<% provide :title, @household.name %>
<div>
  <h1 class="screen-title"><%= @household.name %></h1>
  <p class="screen-subtitle"><%= t("common.members_count", count: @household.users.size) %> · <%= t("chores.index.count", count: @household.chores.count) %></p>
</div>

<section class="flex flex-col gap-3" aria-labelledby="members-title">
  <h2 id="members-title" class="text-base font-bold m-0 font-sans"><%= t("households.show.members_title") %></h2>
  <% if @household.users.empty? %>
    <p class="text-muted m-0"><%= t("households.show.no_members") %></p>
  <% else %>
    <div class="list-stack">
      <% @household.users.each_with_index do |user, index| %>
        <%= list_row title: user.email, leading: avatar(initials: member_initials(user), color: member_color(index), size: 36) %>
      <% end %>
    </div>
  <% end %>
</section>

<% invitations = @household.invitations.where(state: %w[pending declined expired]).order(created_at: :desc).limit(10).each(&:expire_if_due!) %>
<% if invitations.any? %>
  <section class="flex flex-col gap-3" aria-labelledby="invitations-title">
    <h2 id="invitations-title" class="text-base font-bold m-0 font-sans"><%= t("households.show.invitations_title") %></h2>
    <div class="list-stack">
      <% invitations.each do |invitation| %>
        <% state = invitation.current_state %>
        <%= list_row title: invitation.email, href: household_invitation_path(@household, invitation),
              leading: avatar(initials: invitation.email.first.upcase, pending: true, size: 36),
              trailing: status_pill(t("invitations.show.pill.#{state}"), tone: (state == "pending" ? :outline : :soft)) %>
      <% end %>
    </div>
  </section>
<% end %>

<div class="list-stack">
  <%= list_row title: t("households.show.invite_link"), href: new_household_invitation_path(@household) %>
  <%= list_row title: t("chores.setup.title"), href: household_chores_setup_path(@household) %>
  <%= list_row title: t("chores.new.title"), href: new_chore_path(household_id: @household.id) %>
  <%= list_row title: t("common.edit"), href: edit_household_path(@household) %>
  <%= list_row title: t("auth.account.title"), href: account_path %>
</div>

<%= button_to t("common.delete"), household_path(@household), method: :delete, class: "btn btn-outline",
      form: { data: { turbo_confirm: t("households.show.delete_confirm") } } %>
