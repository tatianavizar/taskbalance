<%= form_with model: @household, html: { class: "flex flex-col gap-4 flex-1" } do |f| %>
  <%= f.error_summary %>
  <%= f.field :name, label: t("households.form.name_label"), placeholder: t("households.form.name_placeholder"), autofocus: true %>

  <%= sticky_cta do %>
    <%= f.submit @household.new_record? ? t("households.form.submit_create") : t("households.form.submit_update") %>
  <% end %>
<% end %>
