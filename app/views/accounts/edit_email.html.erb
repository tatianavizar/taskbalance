<% provide :chrome, "none" %>
<% provide :title, t("auth.account.edit_email.title") %>
<%= back_button account_path %>
<h1 class="screen-title"><%= t("auth.account.edit_email.title") %></h1>

<% if @email_change_blocked_until %>
  <%= callout do %>
    <p class="m-0" data-test="email-change-limit"><%= t("auth.account.edit_email.limit_reached", max: User::EMAIL_CHANGES_PER_DAY,
          day: l(@email_change_blocked_until.to_date, format: :day_month), hour: l(@email_change_blocked_until, format: :hour)) %></p>
  <% end %>
<% else %>
  <%= form_with model: current_user, scope: :user, url: edit_email_path, method: :patch, html: { class: "flex flex-col gap-4 flex-1" } do |f| %>
    <%= f.error_summary %>
    <%= f.field :email, as: :email, label: t("auth.account.edit_email.new_email"), autofocus: true, autocomplete: "email",
          hint: t("auth.account.edit_email.hint") %>
    <%= f.field :current_password, as: :password, autocomplete: "current-password", value: nil %>
    <%= sticky_cta do %>
      <%= f.submit t("auth.account.edit_email.submit") %>
    <% end %>
  <% end %>
<% end %>
