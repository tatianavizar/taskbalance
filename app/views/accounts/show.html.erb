<% provide :chrome, "none" %>
<% provide :title, t("auth.account.title") %>
<%= back_button(current_household ? household_path(current_household) : dashboard_path) %>
<h1 class="screen-title"><%= t("auth.account.title") %></h1>

<div class="list-stack">
  <%= list_row title: t("auth.account.first_name"), subtitle: current_user.first_name, href: edit_first_name_path %>
  <%= list_row title: t("auth.account.email"), subtitle: current_user.email, href: edit_email_path,
        trailing: ((status_pill(t("auth.account.email_unconfirmed"), tone: :ink) unless current_user.confirmed? && !current_user.pending_reconfirmation?)) %>
  <% if current_user.pending_reconfirmation? %>
    <%= list_row title: t("auth.confirm_pending.title"), subtitle: current_user.unconfirmed_email, href: pending_user_confirmation_path %>
  <% elsif !current_user.confirmed? %>
    <%= list_row title: t("auth.confirm_pending.title"), href: pending_user_confirmation_path %>
  <% end %>
  <%= list_row title: t("auth.account.password"), subtitle: t("auth.account.password_value"), href: edit_password_path %>
</div>

<section aria-labelledby="notification-settings">
  <h2 id="notification-settings" class="text-[13px] font-bold text-muted mb-2"><%= t("notifications.account.heading") %></h2>
  <p class="field-hint mt-0 mb-2"><%= t("notifications.account.intro") %></p>
  <%= form_with url: account_notifications_path, method: :patch, scope: :preferences, html: { class: "list-stack", data: { controller: "autosubmit" } } do |f| %>
    <% NotificationPreference.settings_for(current_user).each do |event_type, enabled| %>
      <%= label_tag "preferences_#{event_type}", class: "list-row cursor-pointer" do %>
        <span class="flex-1 min-w-0">
          <span class="block font-semibold"><%= t("notifications.event_types.#{event_type}") %></span>
          <span class="block text-[13px] leading-[18px] text-muted"><%= t("notifications.event_hints.#{event_type}") %></span>
        </span>
        <%= hidden_field_tag "preferences[#{event_type}]", "0", id: nil %>
        <%= check_box_tag "preferences[#{event_type}]", "1", enabled, id: "preferences_#{event_type}", class: "switch-input", role: "switch", data: { action: "change->autosubmit#submit" } %>
      <% end %>
    <% end %>
    <%= f.submit t("notifications.account.save"), variant: :secondary %>
  <% end %>
  <% if hotwire_native_app? %>
    <div class="list-stack mt-2">
      <%= list_row title: t("notifications.permission.account_row"), subtitle: t("notifications.permission.account_hint"), href: push_permission_path %>
    </div>
  <% end %>
</section>

<div class="list-stack">
  <%= list_row title: t("chore_logs.index.title"), subtitle: t("chore_logs.index.link_hint"), href: chore_logs_path %>
  <%= list_row title: t("notifications.account.feed"), href: notifications_path %>
  <%= list_row title: t("auth.account.intro"), href: intro_path(1) %>
  <%= list_row title: t("rules.title"), subtitle: t("rules.account_hint"), href: rules_path %>
  <%= list_row title: t("legal.terms.title"), href: terms_path %>
  <%= list_row title: t("legal.privacy.title"), href: privacy_path %>
</div>

<div class="list-stack">
  <%= list_row title: t("auth.delete_account.link"), href: delete_account_path %>
</div>

<%= sticky_cta do %>
  <%= button_to t("auth.account.log_out"), destroy_user_session_path, method: :delete, class: "btn btn-secondary", form: { class: "m-0" } %>
<% end %>
