<% provide :chrome, "none" %>
<% provide :title, t("auth.account.edit_password.title") %>
<%= back_button account_path %>
<div>
  <h1 class="screen-title"><%= t("auth.account.edit_password.title") %></h1>
  <p class="screen-subtitle"><%= t("auth.account.edit_password.hint") %></p>
</div>

<%= form_with model: current_user, scope: :user, url: edit_password_path, method: :patch, html: { class: "flex flex-col gap-4 flex-1" } do |f| %>
  <%= f.error_summary %>
  <%= f.field :current_password, as: :password, label: t("auth.account.edit_password.current"), autofocus: true, autocomplete: "current-password" %>
  <%= f.field :password, as: :password, label: t("auth.account.edit_password.new"), autocomplete: "new-password",
        hint: t("auth.password_hint", count: Devise.password_length.min) %>
  <%= f.field :password_confirmation, as: :password, label: t("auth.account.edit_password.confirm"), autocomplete: "new-password" %>
  <%= sticky_cta do %>
    <%= f.submit t("auth.account.edit_password.submit") %>
  <% end %>
<% end %>
