<% provide :title, strip_tags(t("intro.absence.title_html").gsub("<br>", " ")) %>
<h1 class="font-display font-extrabold text-2xl leading-[35px] m-0 rise delay-1"><%= t("intro.absence.title_html") %></h1>

<div class="card rise delay-2 flex items-center gap-3.5 !rounded-[22px] !px-4 !py-3.5">
  <span class="zero-tile" aria-hidden="true">0<small><%= t("intro.absence.zero_tasks") %></small></span>
  <span><b><%= t("intro.absence.one_week") %></b><br><span class="text-sm leading-5 text-muted"><%= t("intro.absence.one_week_body") %></span></span>
</div>
<div class="card rise delay-3 flex items-center gap-3.5 !rounded-[22px] !px-4 !py-3.5">
  <span class="zero-tile" aria-hidden="true">0<small><%= t("intro.absence.zero_tasks") %></small></span>
  <span>
    <b><%= t("intro.absence.two_weeks") %></b><br>
    <span class="text-sm leading-5 text-muted"><%= t("intro.absence.two_weeks_body") %></span><br>
    <span class="font-display font-extrabold text-sm mt-1 inline-block"><%= t("intro.absence.level_drop") %></span>
  </span>
</div>
<div class="callout rise delay-3 flex gap-3.5 items-start !rounded-[22px]">
  <span class="flex-none w-11 h-11 rounded-[14px] bg-ink flex items-center justify-center gap-[5px]" aria-hidden="true">
    <span class="w-[5px] h-[18px] rounded-sm bg-mint"></span><span class="w-[5px] h-[18px] rounded-sm bg-mint"></span>
  </span>
  <span><b class="text-[17px]"><%= t("intro.absence.pause_title") %></b><br><span class="text-sm leading-5"><%= t("intro.absence.pause_body") %></span></span>
</div>
<p class="m-0 text-[13px] leading-[18px] text-muted"><%= t("intro.absence.note") %></p>
