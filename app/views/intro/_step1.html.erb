<% provide :title, strip_tags(t("intro.charges.title_html").gsub("<br>", " ")) %>
<svg width="96" height="96" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="13" fill="#f6fbf8" stroke="#0f1a14" stroke-width="3"></circle><path class="slice-in" d="M25 8 A13 13 0 1 0 25 32 Z" fill="#c8553d"></path><path d="M20 2 V38" stroke="#0f1a14" stroke-width="3" fill="none"></path></svg>
<h1 class="intro-title rise delay-1"><%= t("intro.charges.title_html") %></h1>

<div class="intro-card rise delay-2 bg-surface">
  <span class="intro-icon bg-self" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.4 1 1.1 1 1.8V16h5v-.3c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3z"></path></svg></span>
  <span><b class="text-[17px]"><%= t("intro.charges.mental_title") %></b><br><span class="text-sm leading-5"><%= t("intro.charges.mental_body") %></span></span>
</div>
<div class="intro-card rise delay-3 bg-ink text-white">
  <span class="intro-icon bg-mint" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0f1a14" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11V6a2 2 0 0 1 4 0v5M11 10V4a2 2 0 0 1 4 0v6M15 10V6a2 2 0 0 1 4 0v8a7 7 0 0 1-7 7h-1a7 7 0 0 1-6-3.4L3 14a2 2 0 0 1 3.4-2L7 13"></path></svg></span>
  <span><b class="text-[17px]"><%= t("intro.charges.execution_title") %></b><br><span class="text-sm leading-5"><%= t("intro.charges.execution_body") %></span></span>
</div>
<p class="m-0 font-semibold rise delay-3"><%= t("intro.charges.note") %></p>
