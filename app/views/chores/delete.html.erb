<%# C7 : ce que la suppression d'une tâche perso garde. Tout membre peut la supprimer (D14). %>
<% provide :chrome, "none" %>
<% provide :title, t("chores.form.delete") %>
<%= back_button household_chores_setup_path(@household) %>
<% total = @log_counts.values.sum %>
<div>
  <h1 class="screen-title"><%= t("chores.delete.title", name: @chore.effective_name) %></h1>
</div>

<div class="flex flex-col gap-4">
  <p class="m-0">
    <% date = l(@chore.created_at.in_time_zone(@household.zone).to_date, format: :short) %>
    <%= @chore.created_by ? t("chores.delete.created", name: @chore.created_by.first_name, date: date) : t("chores.delete.created_unknown", date: date) %>
    <% if total.zero? %>
      <%= t("chores.delete.never_logged") %>
    <% else %>
      <% names = @log_counts.map { |name, count| t("chores.delete.by_member", name: name, count: count) } %>
      <% names = [ @log_counts.keys.first ] if @log_counts.size == 1 %>
      <b><%= t("chores.delete.logged", count: total, names: names.to_sentence, minutes: @logged_minutes) %></b>
    <% end %>
  </p>
  <%= callout do %>
    <p class="m-0 text-sm"><% if total.positive? %><%= t("chores.delete.kept", count: total) %> <% end %><%= t("chores.delete.gone") %></p>
  <% end %>
</div>

<%= sticky_cta do %>
  <%= button_to t("chores.delete.confirm"), chore_path(@chore), method: :delete, class: "btn btn-outline" %>
  <%= link_to t("chores.delete.keep"), household_chores_setup_path(@household), class: "btn btn-secondary" %>
<% end %>
