<% provide :chrome, "none" %>
<% provide :title, t("chore_logs.new.title") %>
<%= back_button chores_path %>
<div>
  <h1 class="screen-title"><%= t("chore_logs.new.title") %></h1>
  <p class="screen-subtitle"><%= @chore.effective_name %></p>
</div>

<%= form_with model: @chore_log, url: chore_completion_path(@chore), method: :post, html: { class: "flex flex-col gap-4 flex-1" } do |f| %>
  <%= f.error_summary %>

  <fieldset class="min-w-0">
    <legend class="field-label"><%= t("chore_logs.form.load_legend") %></legend>
    <%= f.checkbox_field :mental_load, label: t("chore_logs.form.mental_load_label") %>
    <%= f.checkbox_field :execution_load, label: t("chore_logs.form.execution_load_label") %>
  </fieldset>

  <%= f.field :time_spent, as: :number, label: t("chore_logs.form.time_spent_label"), min: 1 %>

  <%= sticky_cta do %>
    <%= f.submit t("chore_logs.form.submit") %>
  <% end %>
<% end %>
