<div class="w-full max-w-lg">
  <h1 class="text-2xl font-semibold mb-1"><%= t("chore_logs.new.title") %></h1>
  <p class="text-gray-500 mb-6"><%= @chore.effective_name %></p>

  <%= form_with model: @chore_log, url: chore_completion_path(@chore), method: :post, local: true do |f| %>
    <% if @chore_log.errors.any? %>
      <div class="mb-4 rounded border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800">
        <ul class="list-disc list-inside">
          <% @chore_log.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <fieldset class="mb-5">
      <legend class="block text-sm font-semibold mb-2"><%= t("chore_logs.form.load_legend") %></legend>

      <label class="flex items-start gap-3 mb-2">
        <%= f.check_box :mental_load, class: "mt-1 h-4 w-4 rounded border-gray-300" %>
        <span class="text-sm"><%= t("chore_logs.form.mental_load_label") %></span>
      </label>

      <label class="flex items-start gap-3">
        <%= f.check_box :execution_load, class: "mt-1 h-4 w-4 rounded border-gray-300" %>
        <span class="text-sm"><%= t("chore_logs.form.execution_load_label") %></span>
      </label>
    </fieldset>

    <div class="mb-6">
      <%= f.label :time_spent, t("chore_logs.form.time_spent_label"), class: "block text-sm font-semibold mb-1" %>
      <%= f.number_field :time_spent, min: 1,
            class: "w-full rounded border border-gray-300 px-3 py-2 focus:border-indigo-500 focus:outline-none" %>
    </div>

    <div class="flex items-center gap-4">
      <%= f.submit t("chore_logs.form.submit"),
            class: "rounded bg-indigo-600 px-4 py-2 text-white font-medium hover:bg-indigo-700 cursor-pointer" %>
      <%= link_to t("common.cancel"), chores_path, class: "text-sm text-gray-600 hover:underline" %>
    </div>
  <% end %>
</div>
