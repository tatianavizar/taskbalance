<%# C5, C6 : tâche perso (ou modification d'une tâche du foyer). %>
<%= form_with model: @chore, html: { class: "flex flex-col gap-5 flex-1" } do |f| %>
  <%= hidden_field_tag :return_to, @return_to if @return_to %>
  <% if @chore.errors.any? %>
    <% order = %i[custom_name category loads time_required assignees frequency times_per_period anchor_on] %>
    <% fields = (@chore.errors.attribute_names - [ :base ]).sort_by { |a| order.index(a) || order.size }.map { |a| Chore.human_attribute_name(a) } %>
    <div class="alert-box" role="alert" id="chore_error_summary">
      <%= sanitize t("forms.error_summary", count: fields.size), tags: %w[b] %>
      <% if fields.any? %><br><%= fields.join(" · ") %><% end %>
      <% @chore.errors[:base].each do |message| %><br><%= message %><% end %>
    </div>
  <% end %>

  <% if @chore.catalogue_chore? %>
    <div>
      <span class="field-label"><%= t("chores.form.task_label") %></span>
      <p class="field-input flex items-center bg-soft-2 text-muted m-0"><%= @chore.effective_name %></p>
    </div>
  <% else %>
    <%= f.field :custom_name, label: t("chores.form.name_label"), placeholder: t("chores.form.name_placeholder"), autocomplete: "off" %>
  <% end %>

  <fieldset class="min-w-0 flex flex-col gap-2" <%= tag.attributes("aria-describedby": ("chore_loads_error" if @chore.errors[:loads].any?)) %>>
    <legend class="field-label"><%= t("chores.form.loads_legend") %></legend>
    <% [ [ :mental_load, :mental ], [ :execution_load, :execution ] ].each do |attribute, key| %>
      <label class="card flex items-start gap-3 cursor-pointer" for="chore_<%= attribute %>">
        <%= f.check_box attribute, class: "check-input" %>
        <span class="check-box"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg></span>
        <span><b><%= t("chores.form.#{key}_title") %></b><br><span class="text-[13px] leading-[18px] text-muted"><%= t("chores.form.#{key}_hint") %></span></span>
      </label>
    <% end %>
    <% if @chore.errors[:loads].any? %>
      <div class="field-error" id="chore_loads_error"><span class="field-error-icon" aria-hidden="true">!</span><span><%= @chore.errors[:loads].first %></span></div>
    <% end %>
  </fieldset>

  <%= f.field :time_required, as: :number, label: t("chores.form.time_required_label"), min: 1, inputmode: "numeric",
        placeholder: (@chore.task&.time_required || 30), hint: t("chores.form.time_required_hint") %>

  <fieldset class="min-w-0" <%= tag.attributes("aria-describedby": [ "chore_assignees_hint", ("chore_assignees_error" if @chore.errors[:assignees].any?) ].compact.join(" ")) %>>
    <legend class="field-label"><%= t("chores.form.assignees_label") %></legend>
    <%= hidden_field_tag "chore[assignee_keys][]", "" %>
    <div class="flex gap-2 flex-wrap">
      <% @participants.each do |participant| %>
        <% id = "chore_assignee_#{participant.key.tr(':', '_')}" %>
        <%= check_box_tag "chore[assignee_keys][]", participant.key, @chore.assignee_keys.include?(participant.key), id: id, class: "person-input", multiple: true %>
        <label for="<%= id %>" class="person-chip">
          <%= avatar(initials: participant.monogram, color: participant.color, pending: participant.provisional?, size: 30) %>
          <%= participant.first_name %>
        </label>
      <% end %>
    </div>
    <div class="field-hint" id="chore_assignees_hint"><%= t("chores.form.assignees_hint") %></div>
    <% if @chore.errors[:assignees].any? %>
      <div class="field-error" id="chore_assignees_error"><span class="field-error-icon" aria-hidden="true">!</span><span><%= @chore.errors[:assignees].first %></span></div>
    <% end %>
  </fieldset>

  <%= f.segmented :frequency, Recurrence::FREQUENCIES.keys.rotate(-1).map { |k| [ t("chores.form.frequencies.#{k}"), k.to_s ] },
        label: t("chores.form.frequency_label") %>

  <%= f.field :times_per_period, as: :number, label: t("chores.form.times_label"), min: 1, max: Recurrence::MAX_TIMES_PER_PERIOD, inputmode: "numeric" %>

  <%= f.field :anchor_on, as: :date, label: t("chores.form.anchor_label"), hint: t("chores.form.anchor_hint") %>

  <%= sticky_cta do %>
    <%= f.submit @chore.new_record? ? t("chores.form.submit_create") : t("chores.form.submit_update") %>
    <% if @chore.persisted? && @chore.custom_chore? %>
      <%= link_to t("chores.form.delete"), delete_chore_path(@chore), class: "btn btn-outline" %>
    <% end %>
  <% end %>
<% end %>
