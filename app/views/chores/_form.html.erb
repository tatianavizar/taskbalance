<%= form_with model: @chore, html: { class: "flex flex-col gap-4 flex-1" } do |f| %>
  <%= f.hidden_field :household_id %>
  <%= f.error_summary %>

  <% category_choices = Chore::CATEGORIES.map { |c| [ t("tasks.categories.#{c}"), c ] } %>

  <% if @chore.new_record? %>
    <%# Tâche perso : catégorie + nom libre %>
    <%= f.select_field :category, category_choices, label: t("chores.form.category_label"),
          options: { prompt: t("chores.form.category_prompt") } %>
    <%= f.field :custom_name, label: t("chores.form.name_label"), placeholder: t("chores.form.name_placeholder") %>

  <% elsif @chore.catalogue_chore? %>
    <%# Tâche du catalogue : le nom est en lecture seule %>
    <div>
      <span class="field-label"><%= t("chores.form.task_label") %></span>
      <p class="field-input flex items-center bg-soft-2 text-muted m-0"><%= @chore.task.name %></p>
    </div>

  <% else %>
    <%= f.select_field :category, category_choices, label: t("chores.form.category_label"), options: { include_blank: false } %>
    <%= f.field :custom_name, label: t("chores.form.name_label") %>
  <% end %>

  <%= f.field :time_required, as: :number, label: t("chores.form.time_required_label"), min: 1,
        placeholder: (@chore.task&.time_required || 30),
        hint: (t("chores.form.time_required_hint", task_default: @chore.task.time_required) if @chore.persisted? && @chore.catalogue_chore?) %>

  <%= f.select_field :assigned_to_id, @members.map { |m| [ m.email, m.id ] }, label: t("chores.form.assigned_to_label"),
        options: { include_blank: t("chores.form.assigned_to_prompt") } %>

  <fieldset class="min-w-0">
    <legend class="field-label"><%= t("chores.form.load_legend") %></legend>
    <p class="field-hint -mt-1 mb-1"><%= t("chores.form.load_note") %></p>
    <%= f.checkbox_field :mental_load, label: t("chores.form.mental_load_label") %>
    <%= f.checkbox_field :execution_load, label: t("chores.form.execution_load_label") %>
  </fieldset>

  <%= f.field :due_date, as: :date, label: t("chores.form.due_date_label") %>

  <%= sticky_cta do %>
    <%= f.submit @chore.new_record? ? t("chores.form.submit_create") : t("chores.form.submit_update") %>
    <% if @chore.persisted? && @chore.custom_chore? %>
      <%= link_to t("chores.form.delete"), chore_path(@chore), class: "btn btn-outline",
            data: { turbo_method: :delete, turbo_confirm: t("chores.form.delete_confirm") } %>
    <% end %>
  <% end %>
<% end %>
