<h1 class="mb-2"><%= t("tasks.index.title") %></h1>
<p class="text-muted"><%= t("tasks.index.intro") %></p>

<% if @tasks_by_category.empty? %>
  <p class="text-muted"><%= t("tasks.index.empty") %></p>
<% else %>
  <% @tasks_by_category.each do |category, tasks| %>
    <h2 class="h5 mt-4"><%= t("tasks.categories.#{category}", default: category.to_s.humanize) %></h2>
    <ul class="list-group">
      <% tasks.each do |task| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= task.name %>
          <% if task.time_required.present? %>
            <span class="text-muted small"><%= t("tasks.index.time_required", count: task.time_required) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

<div class="mt-4">
  <%= link_to t("households.index.title"), households_path %>
</div>
