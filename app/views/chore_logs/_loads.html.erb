<%# Les deux charges (D6, D7, E12) : au moins une. %>
<fieldset class="min-w-0 flex flex-col gap-2" <%= tag.attributes("aria-describedby": ("log_loads_error" if entry.errors[:loads].any?)) %>>
  <legend class="field-label"><%= t("chore_logs.form.load_legend") %></legend>
  <% [ [ :mental_load, :mental ], [ :execution_load, :execution ] ].each do |attribute, key| %>
    <label class="card flex items-start gap-3 cursor-pointer" for="log_entry_<%= attribute %>"
           <%= tag.attributes(style: ("border:2px solid var(--color-ink)" if entry.errors[:loads].any?)) %>>
      <%= f.check_box attribute, class: "check-input", data: { "log-form-target": key } %>
      <span class="check-box"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg></span>
      <span><b><%= t("chore_logs.form.#{key}_title") %></b><br><span class="text-[13px] leading-[18px] text-muted"><%= t("chore_logs.form.#{key}_hint") %></span></span>
    </label>
  <% end %>
  <% if entry.errors[:loads].any? %>
    <div class="field-error" id="log_loads_error"><span class="field-error-icon" aria-hidden="true">!</span><span><%= entry.errors[:loads].first %></span></div>
  <% end %>
</fieldset>
