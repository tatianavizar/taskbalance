<dialog id="confirm-dialog" class="confirm-dialog" aria-labelledby="confirm-dialog-message"
        data-confirm-label="<%= t("common.confirm") %>" data-cancel-label="<%= t("common.cancel") %>">
  <form method="dialog" class="confirm-sheet">
    <p id="confirm-dialog-message" class="font-display text-lg font-bold leading-6 m-0" data-confirm-message></p>
    <div class="flex gap-3">
      <button type="submit" value="cancel" class="btn btn-outline" data-confirm-cancel><%= t("common.cancel") %></button>
      <button type="submit" value="confirm" class="btn btn-outline" data-confirm-accept><%= t("common.confirm") %></button>
    </div>
  </form>
</dialog>
