<%# F6 : déclarer une pause pour soi (dates, raison privée facultative). F8 : une pause pour un membre absent, après une
    descente de niveau : elle l'annule (D3). Pas de raison : la personne la donne, si elle veut. %>
<% provide :chrome, "none" %>
<% self_pause = @target.id == @membership_of_viewer.id %>
<% name = @target.user.first_name %>
<% title = self_pause ? t("pauses.new.title") : t("pauses.new.title_for", name: name) %>
<% provide :title, title %>
<% regression = @household.level_changes.standing_regressions.chronological.last %>
<div class="flex">
  <%= back_button member_pauses_path, label: t("common.close") %>
</div>
<div>
  <h1 class="screen-title"><%= title %></h1>
  <p class="screen-subtitle"><%= self_pause ? t("pauses.new.subtitle") : t("pauses.new.subtitle_for", name: name) %></p>
</div>

<%= form_with model: @pause, url: member_pauses_path, method: :post, html: { class: "flex flex-col gap-5 flex-1" } do |f| %>
  <%= f.error_summary %>
  <% unless self_pause %><%= f.hidden_field :household_member_id, value: @target.id %><% end %>

  <div class="grid grid-cols-2 gap-3">
    <%= f.field :starts_on, as: :date, label: t("pauses.new.from") %>
    <%= f.field :ends_on, as: :date, label: t("pauses.new.to") %>
  </div>
  <p class="field-hint m-0 -mt-3"><%= t("pauses.new.to_hint") %></p>

  <% if self_pause %>
    <%= f.field :reason, label: t("pauses.new.reason"), hint: t("pauses.new.reason_hint"), maxlength: 200, autocomplete: "off" %>
  <% end %>

  <%= callout do %>
    <ul class="m-0 pl-5 text-sm leading-5 flex flex-col gap-1.5">
      <% if self_pause %>
        <li><%= t("pauses.new.rule_not_empty") %></li>
        <li><%= @household.household_members.count == 2 ? t("pauses.new.rule_two") : t("pauses.new.rule_more") %></li>
        <li><%= t("pauses.new.rule_notified") %></li>
      <% else %>
        <li><%= t("pauses.new.for_window", days: MemberPause::RETROACTIVE_DAYS) %></li>
        <% if regression %><li><%= t("pauses.new.for_cancels", level: level_name(regression.from_level)) %></li><% end %>
        <li><%= t("pauses.new.for_notified", name: name) %></li>
      <% end %>
    </ul>
  <% end %>

  <%= sticky_cta do %>
    <%= f.submit(self_pause ? t("pauses.new.submit") : t("pauses.new.submit_for")) %>
    <%= link_to t("common.cancel"), member_pauses_path, class: "btn btn-secondary" %>
  <% end %>
<% end %>
